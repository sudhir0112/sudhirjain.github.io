---
import '../styles/global.css';
import { profile } from '../data/content.js';
const { title, description, noindex } = Astro.props;
const metaDescription = description ?? `${profile.name} — ${profile.title}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <title>{title ?? profile.name}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
