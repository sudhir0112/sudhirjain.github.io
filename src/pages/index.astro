---
import Layout from '../layouts/Layout.astro';
import {
  profile, about, experience, projects, education, skills, certifications,
} from '../data/content.js';
---

<Layout title={`${profile.name} — ${profile.title}`}>
  <nav>
    <div class="container nav-inner">
      <a class="brand" href="#top">SJ</a>
      <div class="links">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#education">Education</a>
        <a href="#contact">Contact</a>
      </div>
    </div>
  </nav>

  <header id="top" class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{profile.location}</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.title}</p>
        <p class="tagline">{profile.tagline}</p>
        <div class="socials">
          {profile.socials.map((s) => (
            <a class="btn" href={s.url} target="_blank" rel="noopener">{s.label}</a>
          ))}
        </div>
      </div>
      <div class="hero-photo">
        <img src={profile.portrait} alt={profile.name} loading="eager" />
      </div>
    </div>
  </header>

  <section id="about">
    <div class="container">
      <h2><span>01</span> About</h2>
      <div class="prose">
        {about.trim().split('\n\n').map((p) => <p>{p.replace(/\n/g, ' ')}</p>)}
      </div>
      <div class="skill-tags">
        {skills.map((s) => <span class="tag">{s}</span>)}
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="container">
      <h2><span>02</span> Experience</h2>
      <div class="timeline">
        {experience.map((e) => (
          <div class="tl-item">
            <div class="tl-left">
              <div class="tl-period">{e.period}</div>
              {e.logo && <div class="tl-logo"><img src={e.logo} alt={e.company} loading="lazy" /></div>}
            </div>
            <div class="tl-body">
              <h3>{e.role}</h3>
              <div class="tl-meta">{e.company} · {e.location}</div>
              <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="container">
      <h2><span>03</span> Selected Projects</h2>
      <div class="grid">
        {projects.map((p) => (
          <article class="card">
            {p.image
              ? <div class="card-img"><img src={p.image} alt={p.name} loading="lazy" /></div>
              : <div class="card-img card-img--ph"><span>{p.name.charAt(0)}</span></div>}
            <div class="card-body">
              <h3>
                {p.url
                  ? <a href={p.url} target="_blank" rel="noopener">{p.name} ↗</a>
                  : p.name}
              </h3>
              <div class="card-role">{p.role}</div>
              <p>{p.description}</p>
              <div class="tags">{p.tech.map((t) => <span class="tag">{t}</span>)}</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="education">
    <div class="container">
      <h2><span>04</span> Education</h2>
      <div class="timeline">
        {education.map((ed) => (
          <div class="tl-item">
            <div class="tl-left">
              <div class="tl-period">{ed.period}</div>
              {ed.logo && <div class="tl-logo"><img src={ed.logo} alt={ed.school} loading="lazy" /></div>}
            </div>
            <div class="tl-body">
              <h3>{ed.degree}</h3>
              <div class="tl-meta">{ed.school}</div>
              <p>{ed.detail}</p>
            </div>
          </div>
        ))}
      </div>
      <h3 class="subhead">Certifications & Continuous Learning</h3>
      <div class="skill-tags">
        {certifications.map((c) => <span class="tag">{c}</span>)}
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="container contact">
      <h2><span>05</span> Get in touch</h2>
      <p>
        Always happy to talk product, AI, or building things from zero.
        Reach me at <a href={`mailto:${profile.email}`}>{profile.email}</a>.
      </p>
      <div class="socials">
        {profile.socials.map((s) => (
          <a class="btn" href={s.url} target="_blank" rel="noopener">{s.label}</a>
        ))}
      </div>
    </div>
  </section>

  <footer>
    <div class="container">© {new Date().getFullYear()} {profile.name}</div>
  </footer>
</Layout>
