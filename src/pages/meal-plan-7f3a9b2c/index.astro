        'गरम मसाला, मिर्च पाउडर, पैपरिका',
        'सूखा ऑरीगानो, नमक, काली मिर्च',
        'राई/सरसों (वैकल्पिक)',
      ],
    },
  },
];

const prepTips = {
  en: [
    { bold: 'Sprout the moong.', rest: ' Soak ½ cup overnight, drain, leave in a damp cloth or jar for 24–36h until tails appear.' },
    { bold: 'Cook the bases.', rest: ' Make 1 batch each of brown rice, quinoa, and lentils. Refrigerate in flat containers — they cool faster and reheat better.' },
    { bold: 'Pressure-cook the rajma', rest: " on Wednesday night for Thursday's dinner." },
    { bold: 'Press tofu in advance.', rest: ' Place between two plates with a weight for 15 min before cooking — it sears better and absorbs spice.' },
    { bold: 'Chop the onion-tomato base.', rest: " A small jar of finely chopped onion + tomato covers Mon, Thu, and Sun's masalas." },
  ],
  hi: [
    { bold: 'मूँग अंकुरित करें।', rest: ' ½ कप रात भर भिगोकर पानी निकाल दें, गीले कपड़े या जार में 24–36 घंटे तक रखें जब तक अंकुर न आ जाएँ।' },
    { bold: 'बेस पहले से तैयार करें।', rest: ' एक-एक बैच ब्राउन चावल, क्विनोआ और मसूर पका लें। चपटे डिब्बे में रखें — जल्दी ठंडे होते हैं और दुबारा गरम करना आसान रहता है।' },
    { bold: 'बुधवार रात राजमा प्रेशर-कुक कर लें', rest: ' — गुरुवार के डिनर के लिए।' },
    { bold: 'टोफू पहले से दबाकर रखें।', rest: ' दो प्लेटों के बीच 15 मिनट वज़न रखकर दबाएँ — मसाला अच्छा सोखेगा और तलने में अच्छा रहेगा।' },
    { bold: 'प्याज़-टमाटर का बेस बना लें।', rest: ' एक छोटे जार में बारीक प्याज़ + टमाटर रखें — सोमवार, गुरुवार और रविवार तीनों के मसालों के काम आएगा।' },
  ],
};

const swaps = {
  en: [
    { bold: 'Lower dairy week?', rest: " Skip the feta on Tuesday, swap Wed's yogurt dollop for guacamole, halve the paneer on Sunday and bump tofu in Monday's dish to 250g." },
    { bold: 'Higher protein push?', rest: ' Add 30g roasted chickpeas as a crunch topping to Mon, Wed, or Fri bowls (~+8g protein).' },
    { bold: 'Dining out one night?', rest: " Drop Saturday's tacos — easiest meal to source vegetarian outside." },
    { bold: "Don't eat brown rice?", rest: " Sub millet (jowar/bajra) or cauliflower rice in Monday's dish." },
  ],
  hi: [
    { bold: 'डेयरी और कम करनी है?', rest: ' मंगलवार को फ़ेटा छोड़ दें, बुधवार की दही की जगह ग्वकामोले लें, रविवार को पनीर आधा कर दें और सोमवार में टोफू 250 ग्राम कर दें।' },
    { bold: 'और प्रोटीन चाहिए?', rest: ' सोम/बुध/शुक्र के बाउल पर 30 ग्राम भुने चने ऊपर से छिड़कें (~+8 ग्राम प्रोटीन)।' },
    { bold: 'एक दिन बाहर खाना है?', rest: ' शनिवार के टैकोज़ छोड़ सकते हैं — बाहर शाकाहारी विकल्प सबसे आसानी से मिलते हैं।' },
    { bold: 'ब्राउन चावल नहीं खाते?', rest: ' सोमवार के डिनर में जौ/बाजरा या फूलगोभी (cauliflower) चावल ले सकते हैं।' },
  ],
};

const i18n = {
  privatePrefix: { en: 'Private · Week of', hi: 'निजी · सप्ताह:' },
  weekDateEn: new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }),
  weekDateHi: new Date().toLocaleDateString('hi-IN', { day: 'numeric', month: 'long', year: 'numeric' }),
  pageTitle: { en: 'Weekly Dinner Plan', hi: 'साप्ताहिक डिनर योजना' },
  tagline: {
    en: 'Seven vegetarian dinners — Indian, Mediterranean, Mexican — designed for weight maintenance and high protein. No eggs. Dairy used in moderation.',
    hi: 'सात शाकाहारी डिनर — भारतीय, भूमध्यसागरीय और मेक्सिकन — वज़न संतुलन और ज़्यादा प्रोटीन के लिए। अंडे नहीं। डेयरी सीमित मात्रा में।',
  },
  pills: {
    en: ['~500 kcal / meal', '25–30g protein', 'Vegetarian, no eggs', 'Dairy: light'],
    hi: ['~500 कैलोरी / डिनर', '25–30 ग्राम प्रोटीन', 'शाकाहारी, अंडे नहीं', 'डेयरी: कम'],
  },
  sections: {
    dinners: { en: 'Dinners', hi: 'डिनर' },
    shopping: { en: 'Shopping list', hi: 'खरीदारी सूची' },
    prep: { en: 'Sunday prep (30 min, saves the week)', hi: 'रविवार की तैयारी (30 मिनट, हफ़्ते भर का काम आसान)' },
    swaps: { en: 'Swaps & tweaks', hi: 'बदलाव और सुझाव' },
  },
  shoppingLead: {
    en: 'Quantities are for a single person, one week. Adjust up for partners or leftovers.',
    hi: 'मात्रा एक व्यक्ति, एक हफ़्ते के लिए है। अगर बचाना है या और लोग हैं तो बढ़ा लें।',
  },
  fieldIngredients: { en: 'Ingredients', hi: 'सामग्री' },
  fieldMethod: { en: 'Method', hi: 'विधि' },
  unitKcal: { en: 'kcal', hi: 'कैलोरी' },
  unitProtein: { en: 'g protein', hi: 'ग्राम प्रोटीन' },
  tonightPill: { en: 'Tonight', hi: 'आज रात' },
  footer: {
    en: 'Private page · not indexed · accessible by direct link only.',
    hi: 'निजी पृष्ठ · सर्च में नहीं · सिर्फ़ सीधे लिंक से खुलता है।',
  },
  backLink: { en: '← back to sudhirjain.com', hi: '← sudhirjain.com पर वापस' },
};
---

<Layout
  title="Weekly Dinner Plan — Sudhir Jain"
  description="Private weekly dinner plan"
  noindex={true}
>
  <div class="mp-root" data-lang="en">
    <header class="page-hero">
      <div class="container">
        <div class="hero-top">
          <p class="eyebrow">
            <span lang="en">{i18n.privatePrefix.en} {i18n.weekDateEn}</span>
            <span lang="hi">{i18n.privatePrefix.hi} {i18n.weekDateHi}</span>
          </p>
          <div class="lang-toggle" role="tablist" aria-label="Language">
            <button data-lang-set="en" class="active" aria-pressed="true">EN</button>
            <button data-lang-set="hi" aria-pressed="false">हिंदी</button>
          </div>
        </div>
        <h1>
          <span lang="en">{i18n.pageTitle.en}</span>
          <span lang="hi">{i18n.pageTitle.hi}</span>
        </h1>
        <p class="tagline">
          <span lang="en">{i18n.tagline.en}</span>
          <span lang="hi">{i18n.tagline.hi}</span>
        </p>
        <div class="brief-tags">
          {i18n.pills.en.map((p, i) => (
            <span class="tag-pill">
              <span lang="en">{p}</span>
              <span lang="hi">{i18n.pills.hi[i]}</span>
            </span>
          ))}
        </div>
      </div>
    </header>

    <main>
      <section class="meals-section">
        <div class="container">
          <h2>
            <span>01</span>
            <span lang="en">{i18n.sections.dinners.en}</span>
            <span lang="hi">{i18n.sections.dinners.hi}</span>
          </h2>
          <div class="meal-grid">
            {meals.map((m, i) => (
              <article class="meal-card" data-day={m.day.en}>
                <div class="meal-head">
                  <div class="meal-day">
                    <span class="day-num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="day-name">
                      <span lang="en">{m.day.en}</span>
                      <span lang="hi">{m.day.hi}</span>
                    </span>
                  </div>
                  <span class="cuisine-badge" style={`--c: ${cuisineColor[m.cuisine]}`}>
                    <span lang="en">{cuisineName[m.cuisine].en}</span>
                    <span lang="hi">{cuisineName[m.cuisine].hi}</span>
                  </span>
                </div>
                <h3>
                  <span lang="en">{m.name.en}</span>
                  <span lang="hi">{m.name.hi}</span>
                </h3>
                <div class="macros">
                  <span>{m.cal} <span lang="en">{i18n.unitKcal.en}</span><span lang="hi">{i18n.unitKcal.hi}</span></span>
                  <span class="dot">·</span>
                  <span>{m.protein}<span lang="en">{i18n.unitProtein.en}</span><span lang="hi"> {i18n.unitProtein.hi}</span></span>
                  <span class="dot">·</span>
                  <span>
                    <span lang="en">{m.time.en}</span>
                    <span lang="hi">{m.time.hi}</span>
                  </span>
                </div>
                <div class="meal-body">
                  <h4>
                    <span lang="en">{i18n.fieldIngredients.en}</span>
                    <span lang="hi">{i18n.fieldIngredients.hi}</span>
                  </h4>
                  <ul lang="en">
                    {m.ingredients.en.map((ing) => <li>{ing}</li>)}
                  </ul>
                  <ul lang="hi">
                    {m.ingredients.hi.map((ing) => <li>{ing}</li>)}
                  </ul>
                  <h4>
                    <span lang="en">{i18n.fieldMethod.en}</span>
                    <span lang="hi">{i18n.fieldMethod.hi}</span>
                  </h4>
                  <p lang="en">{m.method.en}</p>
                  <p lang="hi">{m.method.hi}</p>
                  <div class="meal-note">
                    <span lang="en">{m.note.en}</span>
                    <span lang="hi">{m.note.hi}</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="shopping-section">
        <div class="container">
          <h2>
            <span>02</span>
            <span lang="en">{i18n.sections.shopping.en}</span>
            <span lang="hi">{i18n.sections.shopping.hi}</span>
          </h2>
          <p class="lead">
            <span lang="en">{i18n.shoppingLead.en}</span>
            <span lang="hi">{i18n.shoppingLead.hi}</span>
          </p>
          <div class="shop-grid">
            {shopping.map((s) => (
              <div class="shop-card">
                <h3>
                  <span lang="en">{s.category.en}</span>
                  <span lang="hi">{s.category.hi}</span>
                </h3>
                <ul lang="en">
                  {s.items.en.map((it) => <li>{it}</li>)}
                </ul>
                <ul lang="hi">
                  {s.items.hi.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="tips-section">
        <div class="container">
          <h2>
            <span>03</span>
            <span lang="en">{i18n.sections.prep.en}</span>
            <span lang="hi">{i18n.sections.prep.hi}</span>
          </h2>
          <ul class="tips" lang="en">
            {prepTips.en.map((t) => <li><strong>{t.bold}</strong>{t.rest}</li>)}
          </ul>
          <ul class="tips" lang="hi">
            {prepTips.hi.map((t) => <li><strong>{t.bold}</strong>{t.rest}</li>)}
          </ul>

          <h2 class="sub-h2">
            <span>04</span>
            <span lang="en">{i18n.sections.swaps.en}</span>
            <span lang="hi">{i18n.sections.swaps.hi}</span>
          </h2>
          <ul class="tips" lang="en">
            {swaps.en.map((t) => <li><strong>{t.bold}</strong>{t.rest}</li>)}
          </ul>
          <ul class="tips" lang="hi">
            {swaps.hi.map((t) => <li><strong>{t.bold}</strong>{t.rest}</li>)}
          </ul>
        </div>
      </section>

      <footer class="page-footer">
        <div class="container">
          <p>
            <span lang="en">{i18n.footer.en}</span>
            <span lang="hi">{i18n.footer.hi}</span>
          </p>
          <p class="footer-meta">
            <a href="/">
              <span lang="en">{i18n.backLink.en}</span>
              <span lang="hi">{i18n.backLink.hi}</span>
            </a>
          </p>
        </div>
      </footer>
    </main>
  </div>
</Layout>

<style>
  .page-hero {
    padding: 4rem 0 2.5rem;
    background: radial-gradient(900px 400px at 80% -10%, var(--accent-soft), transparent 70%);
  }
  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.9rem;
  }
  .page-hero .tagline {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .lang-toggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
    background: var(--surface);
  }
  .lang-toggle button {
    background: transparent;
    color: var(--muted);
    border: 0;
    padding: 0.35rem 0.95rem;
    font-size: 0.82rem;
    font-family: inherit;
    cursor: pointer;
    letter-spacing: 0.04em;
    transition: background 0.15s, color 0.15s;
  }
  .lang-toggle button:hover { color: var(--text); }
  .lang-toggle button.active {
    background: var(--accent);
    color: #0b0d12;
    font-weight: 700;
  }

  .brief-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag-pill {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.78rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
  }

  .sub-h2 { margin-top: 2.5rem; }

  .meals-section, .shopping-section, .tips-section { padding: 3rem 0; }

  .meal-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }

  .meal-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .meal-card:hover { border-color: var(--accent); transform: translateY(-2px); }

  .meal-card.is-today {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 10px 30px -10px var(--accent-soft);
  }
  .mp-root[data-lang="en"] .meal-card.is-today::before { content: 'Tonight'; }
  .mp-root[data-lang="hi"] .meal-card.is-today::before { content: 'आज रात'; }
  .meal-card.is-today::before {
    position: absolute;
    top: -10px;
    left: 1rem;
    background: var(--accent);
    color: #0b0d12;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .meal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .meal-day { display: flex; align-items: baseline; gap: 0.6rem; }
  .day-num {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .day-name { color: var(--muted); font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .cuisine-badge {
    color: var(--c);
    border: 1px solid var(--c);
    background: color-mix(in srgb, var(--c) 10%, transparent);
    font-size: 0.72rem;
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }

  .meal-card h3 {
    font-size: 1.05rem;
    margin: 0.3rem 0 0.4rem;
    line-height: 1.3;
  }
  .macros {
    color: var(--muted);
    font-size: 0.82rem;
    margin-bottom: 0.9rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .macros .dot { opacity: 0.5; }

  .meal-body h4 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin: 0.9rem 0 0.45rem;
    font-weight: 600;
  }
  .meal-body ul {
    margin: 0 0 0 1.1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .meal-body li { margin-bottom: 0.2rem; }
  .meal-body p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .meal-note {
    margin-top: 0.9rem;
    padding: 0.7rem 0.85rem;
    background: var(--bg-soft);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .shop-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    margin-top: 1.2rem;
  }
  .shop-card {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem 1.4rem;
  }
  .shop-card h3 {
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
    color: var(--accent);
  }
  .shop-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shop-card li {
    color: var(--muted);
    font-size: 0.9rem;
    padding: 0.25rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .shop-card li:last-child { border-bottom: none; }

  .lead { color: var(--muted); margin-bottom: 0.5rem; }

  .tips {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .tips li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.55;
  }
  .tips li strong { color: var(--text); }

  .page-footer {
    padding: 3rem 0 2.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }
  .footer-meta { margin-top: 0.6rem; }

  /* Language visibility — toggled via [data-lang] on .mp-root */
  .mp-root[data-lang="en"] [lang="hi"] { display: none !important; }
  .mp-root[data-lang="hi"] [lang="en"] { display: none !important; }

  /* Slightly larger line-height for Devanagari readability */
  .mp-root[data-lang="hi"] .meal-body p,
  .mp-root[data-lang="hi"] .meal-body li,
  .mp-root[data-lang="hi"] .tips li,
  .mp-root[data-lang="hi"] .shop-card li,
  .mp-root[data-lang="hi"] .tagline {
    line-height: 1.75;
  }

  @media print {
    .lang-toggle { display: none; }
    .page-hero { background: none; padding: 1rem 0; }
    .meal-card, .shop-card, .tips li {
      break-inside: avoid;
      background: white !important;
      color: black !important;
      border-color: #ccc !important;
    }
  }

  @media (max-width: 760px) {
    .meal-grid { grid-template-columns: 1fr; }
    .shop-grid { grid-template-columns: 1fr; }
    .meal-head { flex-wrap: wrap; gap: 0.5rem; }
    .hero-top { align-items: flex-start; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.mp-root');
    if (!root) return;

    // 1. Language toggle (persisted in localStorage)
    var STORAGE_KEY = 'mealPlanLang';
    var setLang = function (lang) {
      if (lang !== 'en' && lang !== 'hi') lang = 'en';
      root.setAttribute('data-lang', lang);
      var buttons = root.querySelectorAll('[data-lang-set]');
      for (var i = 0; i < buttons.length; i++) {
        var b = buttons[i];
        var match = b.getAttribute('data-lang-set') === lang;
        b.classList.toggle('active', match);
        b.setAttribute('aria-pressed', match ? 'true' : 'false');
      }
      try { localStorage.setItem(STORAGE_KEY, lang); } catch (e) {}
    };
    var saved = 'en';
    try { saved = localStorage.getItem(STORAGE_KEY) || 'en'; } catch (e) {}
    setLang(saved);
    var buttons = root.querySelectorAll('[data-lang-set]');
    for (var i = 0; i < buttons.length; i++) {
      (function (b) {
        b.addEventListener('click', function () { setLang(b.getAttribute('data-lang-set')); });
      })(buttons[i]);
    }

    // 2. Highlight today's card (matches by English day name from data-day)
    var today = new Date().toLocaleDateString('en-US', { weekday: 'long' });
    var card = root.querySelector('.meal-card[data-day="' + today + '"]');
    if (card) card.classList.add('is-today');
  })();
</script>
