---

<Layout
  title="Meal plan — Sudhir Jain"
  description="Private low-FODMAP meal plan"
  noindex={true}
>
  <div class="mp" data-view="sudhir">
    <header class="hero">
      <div class="container">
        <p class="overline">Private · Week of {weekOf}</p>
        <h1>This week's plan</h1>
        <p class="lede">
          Low-FODMAP, lactose-free, no eggs, no onion or garlic — calm on the gut
          while things settle. Two views: yours and Rohit's.
        </p>

        <nav class="tabs" role="tablist" aria-label="View">
          <button data-view-set="sudhir" class="active" aria-pressed="true">
            <span class="tab-label">Sudhir</span>
            <span class="tab-sub">all meals · day-by-day</span>
          </button>
          <button data-view-set="rohit" aria-pressed="false">
            <span class="tab-label">रोहित</span>
            <span class="tab-sub">शाम का खाना · हिंदी</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <!-- ─── Sudhir view ─── -->
      <section class="view sudhir-view">
        <div class="container">
          <div class="days">
            {sudhirDays.map((day, di) => (
              <details class="day-card" data-day={day.day}>
                <summary>
                  <p class="overline day-context">{day.day} · {day.context}</p>
                  <h2 class="day-heading">Dinner: {day.meals[day.meals.length - 1].dish}</h2>
                  <p class="day-meta">{day.meals.length} meals · tap to see the day</p>
                  <span class="expand-hint" aria-hidden="true">
                    <span class="hint-closed">Open day</span>
                    <span class="hint-open">Close</span>
                    <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
                      <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </summary>
                <div class="day-body">
                  {day.meals.map((meal) => (
                    <div class="meal">
                      <p class="overline meal-time">{meal.time} · {meal.label}</p>
                      <h3 class="meal-dish">{meal.dish}</h3>
                      <p class="meal-detail">{meal.detail}</p>
                      {meal.dinner && (
                        <details class="recipe">
                          <summary>
                            <span class="hint-closed">Recipe</span>
                            <span class="hint-open">Hide recipe</span>
                            <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
                              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </summary>
                          <div class="recipe-body">
                            <p class="overline">Ingredients</p>
                            <ul>
                              {meal.dinner.ingredients.en.map((ing) => <li>{ing}</li>)}
                            </ul>
                            <p class="overline">Method</p>
                            <p class="method">{meal.dinner.method.en}</p>
                          </div>
                        </details>
                      )}
                    </div>
                  ))}
                </div>
              </details>
            ))}
          </div>

          <section class="notes">
            <h2 class="section-heading">From your nutritionist</h2>
            {notes.map((n) => (
              <div class="note-card">
                <h3>{n.title}</h3>
                <p>{n.body}</p>
              </div>
            ))}
          </section>
        </div>
      </section>

      <!-- ─── Rohit view (Hindi) ─── -->
      <section class="view rohit-view" lang="hi">
        <div class="container">
          <div class="rohit-greeting">
            <p class="overline">रोहित</p>
            <h2>इस हफ़्ते का शाम का खाना</h2>
            <p class="lede">
              7 डिनर — सोमवार से रविवार तक। आज वाला ऊपर खुला हुआ मिलेगा।
              प्याज़-लहसुन बिल्कुल नहीं — हींग और अदरक इस्तेमाल करें।
            </p>
          </div>

          <div class="dinners">
            {dinners.map((d) => (
              <details class="dinner-card" data-day={d.day}>
                <summary>
                  <p class="overline">{d.dayHi}</p>
                  <h3 class="dinner-name">{d.name.hi}</h3>
                  <p class="dinner-time">{d.time.hi}</p>
                  <span class="expand-hint" aria-hidden="true">
                    <span class="hint-closed">रेसिपी देखें</span>
                    <span class="hint-open">छुपाएँ</span>
                    <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
                      <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </summary>
                <div class="dinner-body">
                  <p class="overline">सामग्री</p>
                  <ul>
                    {d.ingredients.hi.map((ing) => <li>{ing}</li>)}
                  </ul>
                  <p class="overline">बनाने का तरीका</p>
                  <p class="method">{d.method.hi}</p>
                  {d.note && (
                    <div class="note-inline">{d.note.hi}</div>
                  )}
                </div>
              </details>
            ))}
          </div>

          <div class="rohit-outro">
            <p>धन्यवाद रोहित। खाना अच्छा बनाइए, सुधीर का पेट अभी नाज़ुक है।</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="page-footer">
      <div class="container">
        <p>Private page. Not indexed. Direct link only.</p>
        <p class="footer-back"><a href="/">← sudhirjain.com</a></p>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400&display=swap');

  /* Override the portfolio's dark body background just for this page. */
  body {
    background: #FAF7F2 !important;
    color: #1C1B1A !important;
  }
</style>

<style>
  .mp {
    /* Aroha design system tokens */
    --paper: #FAF7F2;
    --surface: #FFFDFB;
    --ink: #1C1B1A;
    --ink-muted: #6B6560;
    --accent: #E8A87C;
    --accent-deep: #A85A30;
    --accent-wash: #F5E4D6;
    --hairline: #EAE4DB;

    font-family: 'Hanken Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--ink);
    background: var(--paper);
    min-height: 100vh;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .mp .container {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ───── Typography ───── */
  .mp h1, .mp h2, .mp h3 {
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
  }
  .mp h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; letter-spacing: -0.02em; }
  .mp h2 { font-size: 1.5rem; line-height: 1.25; }
  .mp h3 { font-size: 1.2rem; line-height: 1.3; }

  .mp .overline {
    font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }

  .mp .lede {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 40rem;
    margin: 0;
  }

  .mp p { margin: 0; }
  .mp a { color: var(--accent-deep); text-decoration: none; border-bottom: 1px solid var(--hairline); }
  .mp a:hover { border-bottom-color: var(--accent-deep); }

  /* ───── Hero ───── */
  .hero {
    padding: 4rem 0 2.5rem;
  }
  .hero h1 { margin: 0.7rem 0 1.2rem; }
  .hero .lede { margin-bottom: 2.5rem; }

  /* ───── Tabs ───── */
  .tabs {
    display: flex;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 0.4rem;
    max-width: 100%;
  }
  .tabs button {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    background: transparent;
    color: var(--ink-muted);
    border: 0;
    padding: 0.75rem 1rem;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    border-radius: 10px;
    transition: background 0.15s, color 0.15s;
  }
  .tabs button:hover { color: var(--ink); }
  .tabs button.active {
    background: var(--accent-wash);
    color: var(--ink);
  }
  .tabs .tab-label { font-size: 1rem; font-weight: 500; letter-spacing: -0.005em; }
  .tabs .tab-sub {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .tabs button.active .tab-sub { color: var(--accent-deep); }

  /* ───── View switch ───── */
  .mp[data-view="sudhir"] .rohit-view { display: none; }
  .mp[data-view="rohit"] .sudhir-view { display: none; }

  /* ───── Section spacing ───── */
  .view { padding: 2rem 0 3rem; }
  .section-heading {
    margin: 3rem 0 1.2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hairline);
  }

  /* ───── Day card (Sudhir view) ───── */
  .days { display: flex; flex-direction: column; gap: 1rem; }

  .day-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .day-card:hover { border-color: var(--accent-deep); }
  .day-card > summary {
    list-style: none;
    cursor: pointer;
    padding: 1.5rem 1.6rem;
    border-radius: 14px;
    -webkit-tap-highlight-color: transparent;
    position: relative;
  }
  .day-card > summary::-webkit-details-marker { display: none; }
  .day-card > summary::marker { display: none; }

  .day-context { margin-bottom: 0.4rem; }
  .day-heading { font-size: 1.25rem; }
  .day-meta {
    margin-top: 0.5rem;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .expand-hint {
    position: absolute;
    top: 1.5rem;
    right: 1.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent-deep);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    user-select: none;
  }
  .expand-hint .chevron { transition: transform 0.2s ease; }
  details[open] > summary .expand-hint .chevron { transform: rotate(180deg); }
  details > summary .hint-open { display: none; }
  details[open] > summary .hint-closed { display: none; }
  details[open] > summary .hint-open { display: inline; }

  .day-body {
    padding: 0 1.6rem 1.5rem;
    border-top: 1px solid var(--hairline);
    padding-top: 1.2rem;
  }

  /* ───── Meal (inside day) ───── */
  .meal {
    padding: 1rem 0;
    border-bottom: 1px dashed var(--hairline);
  }
  .meal:last-child { border-bottom: none; padding-bottom: 0; }
  .meal:first-child { padding-top: 0; }

  .meal-time { margin-bottom: 0.4rem; }
  .meal-dish { font-size: 1.05rem; margin: 0.2rem 0 0.5rem; font-weight: 500; }
  .meal-detail {
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* ───── Recipe (nested inside meal, dinner only) ───── */
  .recipe {
    margin-top: 0.9rem;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background: var(--paper);
  }
  .recipe > summary {
    list-style: none;
    cursor: pointer;
    padding: 0.65rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-deep);
    border-radius: 10px;
    -webkit-tap-highlight-color: transparent;
  }
  .recipe > summary::-webkit-details-marker,
  .recipe > summary::marker { display: none; }
  .recipe > summary .chevron { margin-left: auto; transition: transform 0.2s ease; }
  .recipe[open] > summary .chevron { transform: rotate(180deg); }
  .recipe[open] > summary .hint-closed { display: none; }
  .recipe > summary .hint-open { display: none; }
  .recipe[open] > summary .hint-open { display: inline; }

  .recipe-body {
    padding: 0.2rem 0.9rem 1rem;
  }
  .recipe-body .overline { margin: 0.9rem 0 0.4rem; }
  .recipe-body ul {
    margin: 0 0 0 1.1rem;
    padding: 0;
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .recipe-body li { padding: 0.1rem 0; }
  .recipe-body .method {
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  /* ───── Notes (nutritionist) ───── */
  .notes { display: flex; flex-direction: column; gap: 0.8rem; }
  .note-card {
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: var(--surface);
  }
  .note-card h3 { font-size: 1rem; margin-bottom: 0.35rem; font-weight: 500; }
  .note-card p { color: var(--ink-muted); font-size: 0.95rem; line-height: 1.6; }

  /* ───── Rohit view ───── */
  .rohit-view { line-height: 1.75; }
  .rohit-greeting {
    padding: 0.5rem 0 2.5rem;
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 2rem;
  }
  .rohit-greeting h2 { margin: 0.6rem 0 1rem; font-size: 1.8rem; }
  .rohit-greeting .lede { max-width: none; }

  .dinners { display: flex; flex-direction: column; gap: 0.9rem; }

  .dinner-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .dinner-card:hover { border-color: var(--accent-deep); }
  .dinner-card > summary {
    list-style: none;
    cursor: pointer;
    padding: 1.4rem 1.5rem;
    border-radius: 14px;
    -webkit-tap-highlight-color: transparent;
    position: relative;
  }
  .dinner-card > summary::-webkit-details-marker,
  .dinner-card > summary::marker { display: none; }

  .dinner-name { font-size: 1.25rem; margin: 0.35rem 0 0.3rem; font-weight: 500; }
  .dinner-time { color: var(--ink-muted); font-size: 0.9rem; }

  .dinner-body {
    padding: 0.5rem 1.5rem 1.5rem;
    border-top: 1px solid var(--hairline);
    padding-top: 1.2rem;
  }
  .dinner-body .overline { margin: 1rem 0 0.5rem; }
  .dinner-body .overline:first-child { margin-top: 0; }
  .dinner-body ul {
    margin: 0 0 0 1.2rem;
    padding: 0;
    color: var(--ink-muted);
    font-size: 0.98rem;
    line-height: 1.75;
  }
  .dinner-body li { padding: 0.15rem 0; }
  .dinner-body .method {
    color: var(--ink-muted);
    font-size: 0.98rem;
    line-height: 1.75;
  }
  .note-inline {
    margin-top: 1.1rem;
    padding: 0.9rem 1.1rem;
    background: var(--accent-wash);
    border-radius: 10px;
    font-size: 0.9rem;
    color: var(--ink);
    line-height: 1.65;
  }

  .rohit-outro {
    margin-top: 2.5rem;
    padding: 1.5rem;
    text-align: center;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  /* ───── Today ───── */
  .day-card.is-today, .dinner-card.is-today {
    border-color: var(--accent-deep);
    box-shadow: 0 0 0 1px var(--accent-deep), 0 12px 30px -14px var(--accent-wash);
  }
  .mp[data-view="sudhir"] .day-card.is-today::before,
  .mp[data-view="rohit"] .dinner-card.is-today::before {
    position: absolute;
    top: -10px;
    left: 1.2rem;
    padding: 0.22rem 0.7rem;
    background: var(--accent);
    color: var(--ink);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 999px;
    z-index: 2;
  }
  .mp[data-view="sudhir"] .day-card.is-today::before { content: 'Today'; }
  .mp[data-view="rohit"] .dinner-card.is-today::before { content: 'आज'; }

  /* ───── Footer ───── */
  .page-footer {
    padding: 4rem 0 3rem;
    text-align: center;
    color: var(--ink-muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--hairline);
  }
  .footer-back { margin-top: 0.5rem; }

  /* ───── Print ───── */
  @media print {
    .tabs, .expand-hint, .rohit-outro { display: none !important; }
    .mp[data-view="sudhir"] .rohit-view { display: none; }
    .mp[data-view="rohit"] .sudhir-view { display: none; }
    details > .day-body, details > .dinner-body, details > .recipe-body { display: block !important; }
    .day-card, .dinner-card, .note-card, .recipe {
      break-inside: avoid;
    }
  }

  /* ───── Responsive ───── */
  @media (max-width: 640px) {
    .hero { padding: 3rem 0 2rem; }
    .tabs button { padding: 0.65rem 0.8rem; }
    .day-card > summary, .dinner-card > summary { padding: 1.2rem 1.2rem; }
    .expand-hint { top: 1.2rem; right: 1.2rem; }
    .day-body { padding: 0 1.2rem 1.2rem; padding-top: 1rem; }
    .dinner-body { padding: 0.5rem 1.2rem 1.2rem; padding-top: 1rem; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('.mp');
    if (!root) return;

    // 1. Tab switch (Sudhir / Rohit), persisted
    var KEY = 'mealPlanView';
    var setView = function (view) {
      if (view !== 'sudhir' && view !== 'rohit') view = 'sudhir';
      root.setAttribute('data-view', view);
      var buttons = root.querySelectorAll('[data-view-set]');
      for (var i = 0; i < buttons.length; i++) {
        var b = buttons[i];
        var match = b.getAttribute('data-view-set') === view;
        b.classList.toggle('active', match);
        b.setAttribute('aria-pressed', match ? 'true' : 'false');
      }
      try { localStorage.setItem(KEY, view); } catch (e) {}
    };
    var saved = 'sudhir';
    try { saved = localStorage.getItem(KEY) || 'sudhir'; } catch (e) {}
    setView(saved);
    var buttons = root.querySelectorAll('[data-view-set]');
    for (var i = 0; i < buttons.length; i++) {
      (function (b) {
        b.addEventListener('click', function () { setView(b.getAttribute('data-view-set')); });
      })(buttons[i]);
    }

    // 2. Today: highlight + auto-expand in BOTH views
    var today = new Date().toLocaleDateString('en-US', { weekday: 'long' });
    var todayCards = root.querySelectorAll('[data-day="' + today + '"]');
    for (var j = 0; j < todayCards.length; j++) {
      todayCards[j].classList.add('is-today');
      todayCards[j].setAttribute('open', '');
    }

    // 3. Print: expand every card, restore after
    window.addEventListener('beforeprint', function () {
      var cards = root.querySelectorAll('details');
      for (var i = 0; i < cards.length; i++) {
        cards[i].dataset.printState = cards[i].open ? 'open' : 'closed';
        cards[i].open = true;
      }
    });
    window.addEventListener('afterprint', function () {
      var cards = root.querySelectorAll('details');
      for (var i = 0; i < cards.length; i++) {
        if (cards[i].dataset.printState === 'closed') cards[i].open = false;
        delete cards[i].dataset.printState;
      }
    });
  })();
</script>
